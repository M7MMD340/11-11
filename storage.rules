// غير مُستخدم حالياً — التطبيق يخزن الصور كـ base64 داخل Firestore لتفادي
// الحاجة لخطة Blaze المدفوعة. احتفظنا بهذا الملف لو قررتوا لاحقاً تفعّلون
// Firebase Storage (بعد الترقية لخطة Blaze) لدعم صور/فيديوهات أكبر.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /moments/{coupleId}/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }
  }
}
