{
  "expo": {
    "name": "CoupleApp",
    "slug": "CoupleApp",
    "scheme": "coupleapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج الكاميرا لالتقاط اللحظات ومشاركتها مع شريكك.",
        "NSPhotoLibraryUsageDescription": "نحتاج مكتبة الصور لاختيار صورة لمشاركتها."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكاميرا لالتقاط اللحظات ومشاركتها مع شريكك."
        }
      ]
    ]
  }
}
