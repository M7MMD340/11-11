rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      // Reading by invite code is needed before a user becomes a member.
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isMember(coupleId) ||
        (isSignedIn() &&
         resource.data.members.size() < 2 &&
         request.resource.data.members.size() == resource.data.members.size() + 1 &&
         request.auth.uid in request.resource.data.members);
      allow delete: if false;

      match /{subcollection=**} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
